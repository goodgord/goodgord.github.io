# Cloudflare Pages response headers. See website/README.md.
#
# The Content-Security-Policy keeps everything first-party: styles, scripts, fonts and images come from
# this site only (no inline scripts or styles). frame-src already allows a YouTube or Vimeo embed for
# the Video section. If checkout ever moves onto the page itself, add the payment provider here.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Fonts, images, CSS and JS. Long-lived: when you change site.css or site.js, bump the ?v= number
# where the pages link to them. Give a changed image a new file name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The README is published with the site (Cloudflare serves the whole folder); keep it out of search.
/README.md
  X-Robots-Tag: noindex
